# Copy this file to .env.production and fill in the real values before deployment.
# Never commit the real .env.production file.

DOMAIN=example.com
CADDY_EMAIL=ops@example.com

POSTGRES_DB=dirtyduty
POSTGRES_USER=dirtyduty_user
# Required: set a unique, randomly generated password before starting Compose.
POSTGRES_PASSWORD=

FRONTEND_ORIGINS=https://example.com
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=24h

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@example.com

# Google OIDC sign-in remains disabled until client credentials are configured.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset requires HTTPS APP_BASE_URL, SMTP with STARTTLS, and a
# private random HMAC key of at least 32 characters before enabling.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TTL=30m
AUTH_RATE_LIMIT_HMAC_SECRET=
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_CONFIRM_IP_LIMIT=10
APP_BASE_URL=https://example.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_TLS_VERIFY_SERVER_IDENTITY=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=DirtyDuty

NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
