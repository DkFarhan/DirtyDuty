# For a new host, copy this file to .env.production and fill in real values.
# On an existing host, reconcile settings without replacing local secrets/config.
# Never commit, upload to GitHub, or print the real .env.production file.

DOMAIN=dirtyduty.app
CADDY_EMAIL=ops@example.com

# Use the immutable digest references from the successful publish-images workflow
# artifact. Do not use mutable tags such as latest or sha-<commit> for deployment.
BACKEND_IMAGE=ghcr.io/dkfarhan/dirtyduty-backend@sha256:REPLACE_WITH_64_HEX_DIGEST
FRONTEND_IMAGE=ghcr.io/dkfarhan/dirtyduty-frontend@sha256:REPLACE_WITH_64_HEX_DIGEST

POSTGRES_DB=dirtyduty
POSTGRES_USER=dirtyduty_user
# Required: set a unique, randomly generated password before starting Compose.
POSTGRES_PASSWORD=

FRONTEND_ORIGINS=https://dirtyduty.app
SERVER_FORWARD_HEADERS_STRATEGY=framework
MANAGEMENT_HEALTH_MAIL_ENABLED=false
NOTIFICATION_SCHEDULER_DELAY=60000
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=30d
# Browser persistence lifetime; the server enforces the sliding inactivity timeout.
SESSION_COOKIE_MAX_AGE=365d

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@example.com

# Google OIDC sign-in remains disabled until client credentials are configured.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authentication throttling requires this private, stable random HMAC key
# (at least 32 bytes) even when password reset is disabled. Password reset
# and mandatory production email verification require HTTPS APP_BASE_URL and
# authenticated SMTP with STARTTLS.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_DELIVERY_ENABLED=true
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_TTL=30m
AUTH_RATE_LIMIT_HMAC_SECRET=
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_CONFIRM_IP_LIMIT=10
APP_BASE_URL=https://dirtyduty.app
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_TLS_VERIFY_SERVER_IDENTITY=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=DirtyDuty
