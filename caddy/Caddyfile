{
  email {$CADDY_EMAIL}
}

{$DOMAIN:localhost} {
  tls {$CADDY_EMAIL}

  @api path /api/*
  handle @api {
    reverse_proxy backend:8080 {
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Port {server_port}
      header_up X-Forwarded-For {remote}
    }
  }

  handle {
    reverse_proxy frontend:3000 {
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Port {server_port}
      header_up X-Forwarded-For {remote}
    }
  }
}
