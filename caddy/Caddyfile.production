{
  email {$CADDY_EMAIL}
}

www.dirtyduty.app {
  redir https://dirtyduty.app{uri} 308
}

dirtyduty.app {
  tls {$CADDY_EMAIL}

  @api path /api/*
  handle @api {
    reverse_proxy backend:8080 {
      header_up X-Forwarded-For {remote_host}
    }
  }

  handle {
    reverse_proxy frontend:3000
  }
}
